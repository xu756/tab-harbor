{
  "manifest_version": 3,
  "name": "Tab Harbor",
  "short_name": "Tab Harbor",
  "version": "2.0.0",
  "description": "A calm local-first browser workspace for live tabs and workspaces.",
  "homepage_url": "https://github.com/xu756/tab-harbor",
  "permissions": ["tabs", "tabGroups", "storage", "sidePanel"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html?surface=sidepanel"
  },
  "action": {
    "default_title": "打开 Tab Harbor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
